      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dabei wird der Cache ignoriert und %lld Lücken werden erneut beim Straßennetz angefragt (Straße %lld · Bahn %lld), geschätzt etwa %lld Minuten. Das entspricht einem erneuten Schritt 2: Häkchen und manuelle Auswahlen werden zurückgesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
