          "stringUnit": {
            "state": "translated",
            "value": "Both services agree"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩路一致"
          }
        }
      }
    },
    "两路一致 %lld": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide einig: %lld"
          }
        },
        "en": {
