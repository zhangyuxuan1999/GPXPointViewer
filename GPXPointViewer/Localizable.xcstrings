          }
        }
      }
    },
    "铁路：进/出单步速度 %@/%@、10 s / 100 m 窗口速度 %@/%@ km/h，都 > 170": {
      "comment": "Batch gap fill, tooltip of the auto-classification column (verdict: rail). Placeholders in order: single-step speed entering / leaving the gap; speed over a 10 s / 100 m window entering / leaving the gap (all km/h)",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahn: Einzelschritt-Tempo rein/raus %1$@/%2$@, Tempo im 10-s-/100-m-Fenster %3$@/%4$@ km/h, alle > 170"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rail: single-step speed in/out %1$@/%2$@, 10 s / 100 m window speed %3$@/%4$@ km/h, all > 170"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鐵路：進/出單步速度 %1$@/%2$@、10 s / 100 m 視窗速度 %3$@/%4$@ km/h，都 > 170"
          }
        }
      }
    },
    "铁路：隐含速度 %@ km/h > 200（公路上到不了），前后记录速度 %@/%@ 也支持": {
      "comment": "Batch gap fill, tooltip of the auto-classification column (verdict: rail). Placeholders in order: implied speed across the gap (km/h); recorded speed before the gap; recorded speed after the gap (km/h)",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahn: implizites Tempo %1$@ km/h > 200 (auf der Straße unerreichbar); das aufgezeichnete Tempo davor/danach (%2$@/%3$@) bestätigt das"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rail: implied speed %1$@ km/h > 200 (impossible by road); the recorded speeds before/after (%2$@/%3$@) agree"
