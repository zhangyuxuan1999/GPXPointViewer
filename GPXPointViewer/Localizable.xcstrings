    "匹配": {
      "comment": "Route method (batch window 依据 column, notes): OSRM map matching of the real points around the gap. Glossary: Match",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgleich"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Match"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匹配"
          }
        }
      }
    },
    "匹配 = OSRM 按前后真实轨迹点做地图匹配；上下文 = 从 A 前/B 后的真实点路由再裁到 A–B；约束 = 带两端行进方向的路由；直接 = 两点最短路（没有用到前后轨迹，最容易绕路或接错路）；铁路 = Overpass 铁路几何": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgleich = OSRM-Map-Matching mit den echten Trackpunkten davor und danach; Kontext = Route ab echten Punkten vor A / nach B, dann auf A–B zugeschnitten; Eingeschränkt = Route mit Fahrtrichtung an beiden Enden; Direkt = kürzester Weg zwischen beiden Punkten (ohne den Track davor und danach, führt am ehesten zu Umwegen oder falschen Straßen); Bahn = Bahngeometrie von Overpass"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Match = OSRM map matching on the real track points before and after; Context = route from real points before A / after B, then trimmed to A–B; Constrained = route with the travel direction at both ends; Direct = shortest path between the two points (ignores the surrounding track, most likely to detour or take the wrong road); Rail = Overpass railway geometry"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匹配 = OSRM 按前後真實軌跡點做地圖匹配；上下文 = 從 A 前/B 後的真實點路由再裁到 A–B；約束 = 帶兩端行進方向的路由；直接 = 兩點最短路（沒有用到前後軌跡，最容易繞路或接錯路）；鐵路 = Overpass 鐵路幾何"
          }
        }
      }
    },
    "匹配前后点最远 %@ km / 180 s": {
      "comment": "Derived gap-fill threshold clause: points before/after the gap used for map matching are at most this many km / 180 s away",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgleichpunkte max. %@ km / 180 s entfernt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Match points within %@ km / 180 s"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匹配前後點最遠 %@ km / 180 s"
          }
        }
      }
    },
    "匹配半径 %@ m": {
      "comment": "Derived gap-fill threshold clause: OSRM map-matching radius in metres",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgleichradius %@ m"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Match radius %@ m"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匹配半徑 %@ m"
          }
        }
      }
    },
    "匹配未发：两侧 5 km / 180 s 内没有可用的真实点": {
      "comment": "Route draft notes: map matching was not requested, no usable real points within 5 km / 180 s on either side",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgleich nicht gesendet: keine brauchbaren echten Punkte innerhalb von 5 km / 180 s auf beiden Seiten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Match not sent: no usable real points within 5 km / 180 s on either side"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匹配未發：兩側 5 km / 180 s 內沒有可用的真實點"
          }
        }
      }
    },
    "匹配轨迹：A 前 %lld 点 + B 后 %lld 点，半径 %@ m": {
      "comment": "Route draft notes: map-matching trace. 1 points before anchor A, 2 points after anchor B, 3 matching radius in metres",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgleich-Track: %1$lld Pkt. vor A + %2$lld Pkt. nach B, Radius %3$@ m"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Match trace: %1$lld pts before A + %2$lld pts after B, radius %3$@ m"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匹配軌跡：A 前 %1$lld 點 + B 後 %2$lld 點，半徑 %3$@ m"
          }
        }
      }
    },
    "区间内 %lld": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Bereich: %lld"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In range: %lld"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "區間內 %lld"
          }
        }
      }
    },
    "区间内 %lld 个点（粉色）是乱跳点：在相隔几百米到几公里的位置之间来回跳（大跳 %lld 步、倒退 %lld 步，最大一步 %lld m）——车厢里没信号时设备回放旧位置或两路定位交替。「替换」把它们删掉，「保留」则与合成点按时间混排（不推荐）。": {
      "comment": "Apply-fill confirmation paragraph (jitter points); 1st %lld = number of points in the range (shown pink), 2nd %lld = big-jump steps, 3rd %lld = reversal steps, 4th %lld = largest single step in metres. the bracketed terms are this dialog's Replace / Keep buttons",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Punkte im Bereich (rosa, %1$lld) sind Sprungpunkte: Sie springen zwischen Positionen hin und her, die einige hundert Meter bis mehrere Kilometer auseinanderliegen (große Sprünge: %2$lld, Rückschritte: %3$lld, größter Schritt %4$lld m) – ohne Signal im Zug spielt das Gerät alte Positionen ab oder wechselt zwischen zwei Ortungsquellen. „Ersetzen“ löscht sie, „Behalten“ mischt sie zeitlich mit den synthetischen Punkten (nicht empfohlen)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The points in the range (pink, %1$lld) are jitter points: they jump back and forth between positions a few hundred meters to several kilometers apart (big jumps: %2$lld, reversals: %3$lld, largest step %4$lld m) — with no signal inside the train, the device replays old positions or alternates between two location sources. “Replace” deletes them; “Keep” interleaves them with the synthetic points by time (not recommended)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "區間內 %1$lld 個點（粉紅色）是亂跳點：在相隔幾百公尺到幾公里的位置之間來回跳（大跳 %2$lld 步、倒退 %3$lld 步，最大一步 %4$lld m）——車廂裡沒訊號時裝置回放舊位置或兩路定位交替。「替換」把它們刪掉，「保留」則與合成點按時間混排（不推薦）。"
          }
        }
      }
    },
    "区间内 %lld 个点（粉色）是夹在两锚点之间的现有点（挪锚点后夹进来的，通常是隧道里的基站漂移点或钟慢的点）：「替换」把它们删掉，「保留」则与合成点按时间混排。": {
      "comment": "Apply-fill confirmation paragraph (existing points between the anchors); %lld = number of points in the range (shown pink). the bracketed terms are this dialog's Replace / Keep buttons",
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Punkt (rosa) im Bereich ist ein vorhandener Punkt zwischen den beiden Ankern (nach dem Verschieben eines Ankers hineingeraten, meist ein Funkzellen-Driftpunkt im Tunnel oder ein Punkt mit nachgehender Uhr): „Ersetzen“ löscht ihn, „Behalten“ mischt ihn zeitlich mit den synthetischen Punkten."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Punkte (rosa) im Bereich sind vorhandene Punkte zwischen den beiden Ankern (nach dem Verschieben eines Ankers hineingeraten, meist Funkzellen-Driftpunkte im Tunnel oder Punkte mit nachgehender Uhr): „Ersetzen“ löscht sie, „Behalten“ mischt sie zeitlich mit den synthetischen Punkten."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld point (pink) in the range is an existing point caught between the two anchors (pulled in after moving an anchor; usually a cell-tower drift point in a tunnel or a point with a slow clock): “Replace” deletes it; “Keep” interleaves it with the synthetic points by time."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld points (pink) in the range are existing points caught between the two anchors (pulled in after moving an anchor; usually cell-tower drift points in a tunnel or points with a slow clock): “Replace” deletes them; “Keep” interleaves them with the synthetic points by time."
                }
              }
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "區間內 %lld 個點（粉紅色）是夾在兩錨點之間的現有點（挪錨點後夾進來的，通常是隧道裡的基地台漂移點或鐘慢的點）：「替換」把它們刪掉，「保留」則與合成點按時間混排。"
          }
        }
      }
    },
    "区间内 %lld 个点（粉色）是设备重新定位后带着过时时间戳的出口点：位置正常，时间却比真实早约 %lld 秒。「替换」把其中位置在路线上的保留下来、只把时间按出口速度回推，离路线的删掉由合成点接上；「保留」会让时间线在出口来回跳，不推荐。": {
      "comment": "Apply-fill confirmation paragraph (stale-clock exit points, some of which keep their position with a corrected time); first %lld = number of stale exit points in the range (shown pink), second %lld = seconds their timestamps lag behind. the bracketed terms are this dialog's Replace / Keep buttons",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Punkte im Bereich (rosa, %1$lld) sind Austrittspunkte, die nach der Neuortung des Geräts veraltete Zeitstempel tragen: Die Position stimmt, die Zeit liegt aber etwa %2$lld s zu früh. „Ersetzen“ behält die auf der Route liegenden und berechnet nur ihre Zeit aus der Austrittsgeschwindigkeit neu; die abseits der Route werden gelöscht, die synthetischen Punkte schließen an. „Behalten“ lässt die Zeitachse am Austritt hin und her springen (nicht empfohlen)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The points in the range (pink, %1$lld) are exit points that kept stale timestamps after the device re-acquired its position: the location is fine, but the timestamps are about %2$lld s too early. “Replace” keeps the ones on the route and only recomputes their times from the exit speed, and deletes the ones off the route so the synthetic points take over; “Keep” makes the timeline jump back and forth at the exit (not recommended)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "區間內 %1$lld 個點（粉紅色）是裝置重新定位後帶著過時時間戳記的出口點：位置正常，時間卻比真實早約 %2$lld 秒。「替換」把其中位置在路線上的保留下來、只把時間按出口速度回推，離路線的刪掉由合成點接上；「保留」會讓時間線在出口來回跳，不推薦。"
          }
        }
      }
    },
    "区间内 %lld 个点（粉色）是设备重新定位后带着过时时间戳的出口点：位置正常，时间却比真实早约 %lld 秒。「替换」把它们删掉，由折线上的合成点接上；「保留」会让时间线在出口来回跳，不推荐。": {
      "comment": "Apply-fill confirmation paragraph (stale-clock exit points); first %lld = number of points in the range (shown pink), second %lld = seconds their timestamps lag behind. the bracketed terms are this dialog's Replace / Keep buttons",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Punkte im Bereich (rosa, %1$lld) sind Austrittspunkte, die nach der Neuortung des Geräts veraltete Zeitstempel tragen: Die Position stimmt, die Zeit liegt aber etwa %2$lld s zu früh. „Ersetzen“ löscht sie, die synthetischen Punkte auf der Polylinie schließen an; „Behalten“ lässt die Zeitachse am Austritt hin und her springen (nicht empfohlen)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The points in the range (pink, %1$lld) are exit points that kept stale timestamps after the device re-acquired its position: the location is fine, but the timestamps are about %2$lld s too early. “Replace” deletes them and the synthetic points on the polyline take over; “Keep” makes the timeline jump back and forth at the exit (not recommended)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "區間內 %1$lld 個點（粉紅色）是裝置重新定位後帶著過時時間戳記的出口點：位置正常，時間卻比真實早約 %2$lld 秒。「替換」把它們刪掉，由折線上的合成點接上；「保留」會讓時間線在出口來回跳，不推薦。"
          }
        }
      }
    },
    "区间内 %lld 个点（粉色）是设备重新定位后带着过时时间戳的出口点：位置正常，时间却比真实早约 %lld 秒。它们的位置已作为折线顶点保留——「替换」沿同一路径生成时间正确的点；「保留」会让时间线在出口来回跳，不推荐。": {
      "comment": "Apply-fill confirmation paragraph (stale-clock exit points, already kept as polyline vertices); first %lld = number of points in the range (shown pink), second %lld = seconds their timestamps lag behind. the bracketed terms are this dialog's Replace / Keep buttons",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Punkte im Bereich (rosa, %1$lld) sind Austrittspunkte, die nach der Neuortung des Geräts veraltete Zeitstempel tragen: Die Position stimmt, die Zeit liegt aber etwa %2$lld s zu früh. Ihre Positionen sind bereits als Stützpunkte der Polylinie erhalten – „Ersetzen“ erzeugt entlang desselben Wegs Punkte mit korrekter Zeit; „Behalten“ lässt die Zeitachse am Austritt hin und her springen (nicht empfohlen)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The points in the range (pink, %1$lld) are exit points that kept stale timestamps after the device re-acquired its position: the location is fine, but the timestamps are about %2$lld s too early. Their positions are already kept as polyline vertices — “Replace” generates correctly timed points along the same path; “Keep” makes the timeline jump back and forth at the exit (not recommended)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "區間內 %1$lld 個點（粉紅色）是裝置重新定位後帶著過時時間戳記的出口點：位置正常，時間卻比真實早約 %2$lld 秒。它們的位置已作為折線頂點保留——「替換」沿同一路徑生成時間正確的點；「保留」會讓時間線在出口來回跳，不推薦。"
          }
        }
      }
    },
