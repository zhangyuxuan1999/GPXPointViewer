    "跟随系统": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "System"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "跟隨系統"
          }
        }
      }
    },
    "路径 %@ km 要在 %@ s 内走完（%@ km/h），公路上不可能，端点可能接错路": {
      "comment": "Road-draft warning. 1st = route length in km, 2nd = gap duration in seconds, 3rd = implied speed in km/h (may be \"inf\"); impossible on a road",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ km in %2$@ s (%3$@ km/h) zurückzulegen ist auf der Straße unmöglich; ein Ende liegt evtl. an der falschen Straße"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Covering the %1$@ km route in %2$@ s (%3$@ km/h) is impossible on a road; an end may be on the wrong road"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "路徑 %1$@ km 要在 %2$@ s 內走完（%3$@ km/h），公路上不可能，端點可能接錯路"
          }
        }
      }
    },
    "路径 %@ km 要在 %@ s 内走完（%@ km/h），火车也不可能": {
      "comment": "Reason a rail gap is not filled. 1st = path length in km, 2nd = gap duration in s, 3rd = implied speed in km/h; impossible even for a train",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ km in %2$@ s (%3$@ km/h) zurückzulegen ist selbst für einen Zug unmöglich"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Covering the %1$@ km path in %2$@ s (%3$@ km/h) is impossible even by train"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "路徑 %1$@ km 要在 %2$@ s 內走完（%3$@ km/h），火車也不可能"
          }
        }
      }
    },
    "路径从 A 出发先绕了 %@ m 又回到 A 附近（%@ m）：按最后一次离开截断": {
      "comment": "Routing note: the route left anchor A, looped and came back near A; it is cut at the last departure. 1st = length of the loop in m, 2nd = distance from A when passing again in m",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Route verlässt A, fährt eine Schleife von %1$@ m und kommt wieder nahe an A (%2$@ m): beim letzten Verlassen abgeschnitten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The route leaves A, loops %1$@ m and comes back near A (%2$@ m): cut at the last departure"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "路徑從 A 出發先繞了 %1$@ m 又回到 A 附近（%2$@ m）：按最後一次離開截斷"
          }
        }
      }
    },
    "路径第一次到 B 附近（%@ m）后又绕了 %@ m 才回到 B：按第一次到达截断": {
      "comment": "Routing note: the route reached anchor B, then detoured before coming back; it is cut at the first arrival. 1st = distance from B at the first arrival in m, 2nd = length of the extra detour in m",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Route kommt zuerst nahe an B (%1$@ m) und macht dann %2$@ m Umweg bis B: bei der ersten Ankunft abgeschnitten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The route first gets near B (%1$@ m), then detours %2$@ m before returning to B: cut at the first arrival"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "路徑第一次到 B 附近（%1$@ m）後又繞了 %2$@ m 才回到 B：按第一次到達截斷"
          }
        }
      }
    },
    "路由在锚点附近经过了不止一次（%lld/%lld 次），按沿线顺序取 A 之后第一次到 B 的那段，折返不进草稿": {
      "comment": "Routing note. 1st/2nd = how many times the route passes near anchor A/B; the section from A to the first arrival at B is used, the back-and-forth is dropped",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Route passiert die Anker mehrmals (%1$lld/%2$lld Mal); verwendet wird der Abschnitt von A bis zur ersten Ankunft bei B entlang der Route, das Hin und Her kommt nicht in den Entwurf"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The route passes near the anchors more than once (%1$lld/%2$lld passes); the section from A to the first arrival at B along the route is used, and the back-and-forth stays out of the draft"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "路由在錨點附近經過了不止一次（%1$lld/%2$lld 次），按沿線順序取 A 之後第一次到 B 的那段，折返不進草稿"
          }
        }
      }
    },
    "路线上有 %lld 处折返（相邻路段方向翻转超过 150°）": {
      "comment": "Plausibility reason: the route doubles back on itself. %lld = number of U-turn-like reversals",
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Die Route kehrt %lld-mal um (benachbarte Abschnitte drehen um mehr als 150°)"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Die Route kehrt %lld-mal um (benachbarte Abschnitte drehen um mehr als 150°)"
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The route doubles back %lld time (adjacent segments turn by more than 150°)"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The route doubles back %lld times (adjacent segments turn by more than 150°)"
                }
              }
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "路線上有 %lld 處折返（相鄰路段方向翻轉超過 150°）"
          }
        }
      }
    },
    "路线末段方向与 B 侧行进方向差 %@°": {
      "comment": "Plausibility reason: the route ends in a different direction than the track continues after anchor B. %@ = angle in degrees",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Route endet %@° abweichend von der Fahrtrichtung bei B"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The route ends %@° off the direction of travel at B"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "路線末段方向與 B 側行進方向差 %@°"
          }
        }
      }
    },
    "路线沿途换了 %lld 次路（先从 %@ 换到 %@）": {
      "comment": "Plausibility reason: the route changes road several times. 1st = number of changes, 2nd = road before the first change, 3rd = road after it",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Route wechselt %lld-mal die Straße (zuerst von %@ auf %@)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The route changes road %lld times (first from %@ to %@)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "路線沿途換了 %lld 次路（先從 %@ 換到 %@）"
          }
        }
      }
    },
    "路线沿途道路从 %@ 换到 %@": {
      "comment": "Plausibility reason: the route changes road once. 1st = road ref/name before, 2nd = road after",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Route wechselt von %@ auf %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The route changes road from %@ to %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "路線沿途道路從 %@ 換到 %@"
          }
        }
      }
    },
    "路线终点所在道路（%@）与 B 侧所在道路（%@）不同": {
      "comment": "Plausibility reason: the route ends on a different road than the track continues on after anchor B. 1st = route's last road, 2nd = road at B",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Route endet auf einer anderen Straße (%@) als die Spur nach B (%@)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The route ends on a different road (%@) than the track after B (%@)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "路線終點所在道路（%@）與 B 側所在道路（%@）不同"
          }
        }
      }
    },
    "路线起始方向与 A 侧行进方向差 %@°": {
      "comment": "Plausibility reason: the route starts in a different direction than the track was travelling at anchor A. %@ = angle in degrees",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Route beginnt %@° abweichend von der Fahrtrichtung bei A"
          }
