      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Diese Lücken verwenden Straßennetz-Ergebnisse, die seit dem Öffnen dieser Datei abgerufen wurden, ohne neue Anfrage; zum erneuten Abrufen „Alle erneut abrufen …“ verwenden oder eine Zeile rechtsklicken"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
