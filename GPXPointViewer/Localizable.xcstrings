          }
        }
      }
    },
    "路网结果来自缓存（本文件打开以来取过）": {
      "comment": "Route note: this result was served from the in-memory cache (fetched earlier for this file) instead of a new request",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Straßennetz-Ergebnis aus dem Cache (seit dem Öffnen dieser Datei abgerufen)"
          }
