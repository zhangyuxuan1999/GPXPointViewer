    "橙线 = 补点走向（拖顶点调整，双击删；拖段中点加顶点）": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Orange Linie = Füllverlauf (Stützpunkt ziehen zum Anpassen, Doppelklick zum Löschen; Segmentmitte ziehen zum Hinzufügen eines Stützpunkts)"
          }
        },
        "en": {
