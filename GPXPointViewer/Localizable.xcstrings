            "value": "%1$@ – %2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ~ %2$@"
          }
        }
      }
    },
    "%@ · 直线 %@ · %@ · 隐含 %lld km/h": {
      "comment": "Batch gap fill compact card, gap facts. Placeholders in order: start time of the gap; straight-line distance with unit (e.g. 1.2 km); duration with unit (e.g. 5 min); implied speed in km/h",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · Luftlinie %2$@ · %3$@ · implizit %4$lld km/h"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · straight-line %2$@ · %3$@ · implied %4$lld km/h"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · 直線 %2$@ · %3$@ · 隱含 %4$lld km/h"
          }
        }
      }
    },
    "%@ 个点": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Punkte"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ points"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 個點"
          }
        }
      }
    },
    "%@ 侧 %lld°（%@ / %@ s 外的点）": {
      "comment": "Route draft notes, direction of travel on one side. 1 anchor letter A or B, 2 bearing in degrees, 3 distance with unit, 4 seconds of the point used",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seite %1$@: %2$lld° (Punkt jenseits von %3$@ / %4$@ s)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Side %1$@: %2$lld° (point beyond %3$@ / %4$@ s)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 側 %2$lld°（%3$@ / %4$@ s 外的點）"
          }
        }
      }
    },
    "%@ 侧上下文：%@ 外的真实点（距 %@ %@ s，%@）": {
      "comment": "Route draft notes, context point line. 1 anchor letter A or B, 2 distance with unit, 3 the same anchor letter, 4 seconds from the anchor, 5 with/without direction of travel",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontext auf Seite %@: echter Punkt jenseits von %@ (Abstand zu %@: %@ s, %@)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Side %@ context: real point beyond %@ (from %@: %@ s, %@)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 側上下文：%@ 外的真實點（距 %@ %@ s，%@）"
          }
        }
      }
    },
    "%@ 侧上下文：%@ 外的真实点（距 %@ %@ s，%@；150 m 档没走到：%@，退到 %@ m 档）": {
      "comment": "Route draft notes, context point line (fallback tier). 1 anchor letter A or B, 2 distance with unit, 3 the same anchor letter, 4 seconds from the anchor, 5 with/without direction of travel, 6 why the 150 m tier was not reached, 7 the smaller tier in metres that was used",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontext auf Seite %@: echter Punkt jenseits von %@ (Abstand zu %@: %@ s, %@; 150-m-Stufe nicht erreicht: %@, Rückfall auf die %@-m-Stufe)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Side %@ context: real point beyond %@ (from %@: %@ s, %@; 150 m tier not reached: %@, fell back to the %@ m tier)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 側上下文：%@ 外的真實點（距 %@ %@ s，%@；150 m 檔沒走到：%@，退到 %@ m 檔）"
          }
        }
      }
    },
    "%@ 侧偏到对向那一边、另一侧正常，单侧不作判定": {
      "comment": "Driving-side check verdict (after an arrow). %@ = anchor letter A or B whose side is off; the other side is fine, one side alone is not conclusive",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seite %@ weicht zur Gegenfahrbahn ab, die andere Seite ist normal; eine Seite allein ist nicht aussagekräftig"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Side %@ is off toward the opposite carriageway while the other side is normal; one side alone is not conclusive"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 側偏到對向那一邊、另一側正常，單側不作判定"
          }
        }
      }
    },
    "%@ 侧未用上下文：%@": {
      "comment": "Route draft notes: 1 anchor letter A or B, 2 reason; no context point used on that side",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Kontext auf Seite %1$@: %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No context on side %1$@: %2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 側未用上下文：%2$@"
          }
        }
      }
    },
    "%@ 侧未用上下文：%@，交给地图匹配": {
      "comment": "Route draft notes: 1 anchor letter A or B, 2 reason; no context point used on that side, left to map matching",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Kontext auf Seite %1$@: %2$@; dem Kartenabgleich überlassen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No context on side %1$@: %2$@; left to map matching"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 側未用上下文：%2$@，交給地圖匹配"
          }
        }
      }
    },
    "%@ 侧未约束（%@）": {
      "comment": "Route draft notes: 1 anchor letter A or B, 2 reason; no direction constraint on that side",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seite %1$@ nicht eingeschränkt (%2$@)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Side %1$@ unconstrained (%2$@)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 側未約束（%2$@）"
          }
        }
      }
    },
    "%@ 刚被限流，冷却中（还有 %@ s），这一路先放弃": {
      "comment": "Routing error (precise mode): the server rate-limited us and is in a cool-down; this leg is abandoned. Placeholders: host name, remaining seconds",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat uns gerade limitiert und kühlt ab (noch %2$@ s); dieser Zweig wird aufgegeben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ just rate-limited us and is cooling down (%2$@ s left); this leg is abandoned"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 剛被限流，冷卻中（還有 %2$@ s），這一路先放棄"
          }
        }
      }
    },
    "%@ 取路中…": {
      "comment": "Gap Fill bar, single-gap cross-check progress: this router is still being requested. %@ = router name (OSRM / Valhalla, untranslated). Shown as part of one line like “OSRM ✓ · Valhalla fetching…”",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird abgerufen…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fetching…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 取路中…"
          }
        }
      }
    },
    "%@ 年": {
      "comment": "Date row: the data covers a single year, shown as text instead of a picker; %@ = year number",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Jahr"
          }
        },
        "en": {
          "stringUnit": {
