        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The road route has no intermediate points (a straight line will do)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "路網路徑沒有中間點（直線即可）"
          }
        }
      }
    },
    "路网长度是直线的 %@ 倍": {
      "comment": "Plausibility reason: route length divided by the straight-line distance between the anchors. %@ = ratio",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Route ist %@-mal so lang wie die Luftlinie"
          }
        },
