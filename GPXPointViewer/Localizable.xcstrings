          "stringUnit": {
            "state": "translated",
            "value": "The route starts %@° off the direction of travel at A"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "路線起始方向與 A 側行進方向差 %@°"
          }
        }
      }
    },
    "路线起点所在道路（%@）与 A 侧所在道路（%@）不同": {
      "comment": "Plausibility reason: the route starts on a different road than the track was on before anchor A. 1st = route's first road, 2nd = road at A",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Route beginnt auf einer anderen Straße (%@) als die Spur vor A (%@)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The route starts on a different road (%@) than the track before A (%@)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
