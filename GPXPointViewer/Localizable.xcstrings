        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "地圖：鐵路資料沒拿到（Overpass 逾時/排隊），沒法判；可點「重新用地圖判斷」再試，或手選本段"
          }
        }
      }
    },
