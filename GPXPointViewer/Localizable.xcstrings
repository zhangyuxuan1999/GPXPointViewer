    "乱跳": {
      "comment": "Batch gap fill: gap cause — jitter, positions jumping back and forth (glossary 乱跳 = jitter)",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprünge"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jitter"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "亂跳"
          }
        }
      }
    },
    "乱跳只删点 %lld": {
      "comment": "Batch gap fill step 3 summary: %lld jitter gaps will only have their jitter points deleted",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprünge, nur löschen: %lld"
          }
        },
        "en": {
