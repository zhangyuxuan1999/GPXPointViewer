        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the map: thin green line = adopted route, blue dashed = the other route"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "地圖上：綠細線 = 採用的那路，藍虛線 = 另一路"
          }
        }
      }
    },
    "地图上：蓝实线 = OSRM，蓝虚线 = Valhalla（都未采用）": {
