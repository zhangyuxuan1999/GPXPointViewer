            "value": "等級 %lld"
          }
        }
      }
    },
    "等级 / 探索面积 / 地球占比，算法与《世界迷雾》一致（2²²×2²² 格网 + 逐格纬度面积 + 等级=√(面积×250)）": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Level / Erkundete Fläche / Erdanteil, berechnet wie in Fog of World (2²²×2²²-Raster + breitenabhängige Fläche je Zelle + Level = √(Fläche×250))"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Level / Explored Area / Earth Coverage, computed the same way as Fog of World (2²²×2²² grid + per-cell latitude-dependent area + level = √(area×250))"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等級 / 探索面積 / 地球佔比，演算法與《世界迷霧》一致（2²²×2²² 格網 + 逐格緯度面積 + 等級=√(面積×250)）"
          }
        }
      }
    },
    "等级 = ⌊√(已探索 km² × 250)⌋（世界迷雾口径）": {
