          }
        }
      }
    },
    "路网没有找到路径（%@）": {
      "comment": "Routing error. %@ = reason, e.g. no drivable road near the anchor",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Weg im Straßennetz gefunden (%@)"
