            "value": "%@ cells"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 格"
          }
        }
      }
    },
    "%@ 没有结果": {
      "comment": "Gap Fill bar, single-gap cross-check progress: this router returned no route. %@ = router name (OSRM / Valhalla, untranslated). Shown as part of one line like “OSRM ✓ · Valhalla no result”",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kein Ergebnis"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no result"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 沒有結果"
          }
        }
      }
    },
    "%@ 点": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Punkte"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ points"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 點"
          }
        }
      }
    },
    "%@ 离路 %@ m、再往外 %lld 个点离路 %@ m，第 %lld 个点回到路上（%@ m）→ 隧道口定位漂移：%@ 前移 %lld 点，跳过的点随区间一起替换": {
      "comment": "Tunnel-portal drift note, anchor moved earlier in time (A side). 1st = anchor letter (A or B), 2nd = anchor distance from the road in m, 3rd = number of further outward points also off the road, 4th = their distances in m joined by /, 5th = ordinal of the first point back on the road, 6th = its distance from the road in m, 7th = anchor letter again, 8th = number of points the anchor moves",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ liegt %@ m abseits der Straße, die nächsten %lld Punkt(e) weiter außen liegen %@ m abseits, der %lld. Punkt ist wieder auf der Straße (%@ m) → Drift am Tunnelportal: %@ um %lld Punkt(e) früher gesetzt; übersprungene Punkte werden mit dem Bereich ersetzt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is %@ m off the road, the next %lld point(s) out are %@ m off, point %lld is back on the road (%@ m) → tunnel-portal drift: %@ moved %lld point(s) earlier; skipped points are replaced along with the range"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 離路 %@ m、再往外 %lld 個點離路 %@ m，第 %lld 個點回到路上（%@ m）→ 隧道口定位漂移：%@ 前移 %lld 點，跳過的點隨區間一起替換"
          }
        }
      }
    },
    "%@ 离路 %@ m、再往外 %lld 个点离路 %@ m，第 %lld 个点回到路上（%@ m）→ 隧道口定位漂移：%@ 后移 %lld 点，跳过的点随区间一起替换": {
      "comment": "Tunnel-portal drift note, anchor moved later in time (B side). 1st = anchor letter (A or B), 2nd = anchor distance from the road in m, 3rd = number of further outward points also off the road, 4th = their distances in m joined by /, 5th = ordinal of the first point back on the road, 6th = its distance from the road in m, 7th = anchor letter again, 8th = number of points the anchor moves",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ liegt %@ m abseits der Straße, die nächsten %lld Punkt(e) weiter außen liegen %@ m abseits, der %lld. Punkt ist wieder auf der Straße (%@ m) → Drift am Tunnelportal: %@ um %lld Punkt(e) später gesetzt; übersprungene Punkte werden mit dem Bereich ersetzt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is %@ m off the road, the next %lld point(s) out are %@ m off, point %lld is back on the road (%@ m) → tunnel-portal drift: %@ moved %lld point(s) later; skipped points are replaced along with the range"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 離路 %@ m、再往外 %lld 個點離路 %@ m，第 %lld 個點回到路上（%@ m）→ 隧道口定位漂移：%@ 後移 %lld 點，跳過的點隨區間一起替換"
          }
        }
      }
    },
    "%@ 离路 %@ m，但往外第 %lld 个点处停了车，不再外推；末端渐进靠拢": {
      "comment": "Tunnel-portal drift note. 1st = anchor letter (A or B), 2nd = distance of the anchor from the road in m, 3rd = ordinal of the outward point where the vehicle stopped; the anchor is not moved further, the route end is tapered",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ liegt %2$@ m abseits der Straße, aber am %3$lld. Punkt weiter außen hat das Fahrzeug angehalten, daher keine weitere Verschiebung; Routenende allmählich an den Anker herangeführt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is %2$@ m off the road, but the vehicle stopped at point %3$lld further out, so no further shift; route end tapered toward the anchor"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 離路 %2$@ m，但往外第 %3$lld 個點處停了車，不再外推；末端漸進靠攏"
          }
        }
      }
    },
    "%@ 离路 %@ m，但这一侧没有可用的上下文点，判断不了是不是隧道口漂移；末端渐进靠拢": {
      "comment": "Tunnel-portal drift note. 1st = anchor letter (A or B, keep as is), 2nd = distance of the anchor from the road in m; no context points on this side, so drift cannot be judged; the route end is tapered towards the anchor",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ liegt %2$@ m abseits der Straße, aber auf dieser Seite gibt es keine brauchbaren Kontextpunkte, daher ist Drift am Tunnelportal nicht beurteilbar; Routenende allmählich an den Anker herangeführt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is %2$@ m off the road, but this side has no usable context points, so tunnel-portal drift cannot be judged; route end tapered toward the anchor"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 離路 %2$@ m，但這一側沒有可用的上下文點，判斷不了是不是隧道口漂移；末端漸進靠攏"
          }
        }
      }
    },
    "%@ 离路 %@ m，往外 %lld 个点（%@ m 内）离路 %@–%@ m 都没回到路上：不像隧道口漂移（像整体偏移或对向车道），不挪锚点，末端渐进靠拢": {
      "comment": "Tunnel-portal drift note. 1st = anchor letter (A or B), 2nd = anchor distance from the road in m, 3rd = number of outward points checked, 4th = how far out they reach in m, 5th/6th = min/max distance of those points from the road in m; not a portal drift (looks like a global offset or the opposite carriageway), the anchor is not moved, the route end is tapered",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ liegt %@ m abseits der Straße; die %lld Punkt(e) weiter außen (innerhalb von %@ m) liegen %@–%@ m abseits, keiner kehrt zur Straße zurück: keine Drift am Tunnelportal (eher Gesamtversatz oder Gegenfahrbahn); Anker nicht verschoben, Routenende allmählich herangeführt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is %@ m off the road; the %lld point(s) further out (within %@ m) are %@–%@ m off and none returns to the road: not tunnel-portal drift (looks like an overall offset or the opposite carriageway); anchor not moved, route end tapered toward it"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 離路 %@ m，往外 %lld 個點（%@ m 內）離路 %@–%@ m 都沒回到路上：不像隧道口漂移（像整體偏移或對向車道），不挪錨點，末端漸進靠攏"
          }
        }
      }
    },
    "%@ 离路 %@ m，第 %lld 个点回到路上（%@ m）→ 隧道口定位漂移：%@ 前移 %lld 点，跳过的点随区间一起替换": {
      "comment": "Tunnel-portal drift note, anchor moved earlier in time (A side). 1st = anchor letter (A or B), 2nd = anchor distance from the road in m, 3rd = ordinal of the first point back on the road, 4th = its distance from the road in m, 5th = anchor letter again, 6th = number of points the anchor moves",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ liegt %@ m abseits der Straße, der %lld. Punkt ist wieder auf der Straße (%@ m) → Drift am Tunnelportal: %@ um %lld Punkt(e) früher gesetzt; übersprungene Punkte werden mit dem Bereich ersetzt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is %@ m off the road, point %lld is back on the road (%@ m) → tunnel-portal drift: %@ moved %lld point(s) earlier; skipped points are replaced along with the range"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 離路 %@ m，第 %lld 個點回到路上（%@ m）→ 隧道口定位漂移：%@ 前移 %lld 點，跳過的點隨區間一起替換"
          }
        }
      }
    },
    "%@ 离路 %@ m，第 %lld 个点回到路上（%@ m）→ 隧道口定位漂移：%@ 后移 %lld 点，跳过的点随区间一起替换": {
      "comment": "Tunnel-portal drift note, anchor moved later in time (B side). 1st = anchor letter (A or B), 2nd = anchor distance from the road in m, 3rd = ordinal of the first point back on the road, 4th = its distance from the road in m, 5th = anchor letter again, 6th = number of points the anchor moves",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ liegt %@ m abseits der Straße, der %lld. Punkt ist wieder auf der Straße (%@ m) → Drift am Tunnelportal: %@ um %lld Punkt(e) später gesetzt; übersprungene Punkte werden mit dem Bereich ersetzt"
          }
        },
        "en": {
          "stringUnit": {
