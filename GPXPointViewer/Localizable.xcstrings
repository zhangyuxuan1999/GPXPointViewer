    "依据 %@": {
      "comment": "Batch gap fill status clause: how the route was obtained; %@ = route method name (Match / Context / Constrained / Direct / Rail / Delete Only)",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Methode: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Method: %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依據 %@"
          }
        }
      }
    },
    "依据：匹配 = 按前后真实点做地图匹配 · 上下文 = 从前后真实点路由再裁 · 约束 = 带行进方向 · 直接 = 两点最短路": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Methode: Abgleich = Kartenabgleich mit den echten Punkten davor/danach · Kontext = Route ab den echten Punkten davor/danach, dann zugeschnitten · Eingeschränkt = mit Fahrtrichtung · Direkt = kürzester Weg zwischen den zwei Punkten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Method: Match = map-match to the real points before/after · Context = route from the real points before/after, then trim · Constrained = with direction of travel · Direct = shortest path between the two points"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依據：匹配 = 按前後真實點做地圖匹配 · 上下文 = 從前後真實點路由再裁 · 約束 = 帶行進方向 · 直接 = 兩點最短路"
          }
        }
      }
    },
    "保留的真实点离路线最远 %@ m": {
      "comment": "Plausibility reason: a real point kept inside the gap lies far from the route. %@ = distance in m",
