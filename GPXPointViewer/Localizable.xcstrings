        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld exit point has a stale timestamp (Garmin-type device): its position is kept as a polyline vertex and replaced with a correctly timed point on apply"
                }
              },
              "other": {
                "stringUnit": {
