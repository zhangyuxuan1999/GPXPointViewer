    "整批撤回上一次落地的补点": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuletzt übernommene Lückenfüllung als Ganzes zurücknehmen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
