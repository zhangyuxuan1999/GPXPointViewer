    "把勾选的 %lld 处补进轨迹：新增 %lld 个点、替换 %lld 个原始点。落地后在「修改记录」里可逐处还原。": {
      "comment": "Pre-apply review › Apply confirmation. Placeholders in order: number of gaps ticked; points added; original points replaced",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markierte Lücken in den Track einfügen: Lücken %1$lld · Punkte hinzugefügt %2$lld · Originalpunkte ersetzt %3$lld. Danach lässt sich jede im Änderungsprotokoll rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill the ticked gaps into the track: gaps %1$lld · points added %2$lld · original points replaced %3$lld. Afterwards each one can be reverted in the Change Log."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把勾選的 %1$lld 處補進軌跡：新增 %2$lld 個點、替換 %3$lld 個原始點。落地後在「修改記錄」裡可逐處還原。"
          }
        }
      }
    },
    "把当前列表里的断档一次取路网草稿：先确认每处走公路还是铁路，取完在主地图预览，再一次落地": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Straßenentwürfe für alle Lücken der aktuellen Liste auf einmal abrufen: zuerst für jede Lücke Straße oder Bahn festlegen, dann in der Hauptkarte prüfen und gesammelt übernehmen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fetch road drafts for all gaps in the current list at once: first confirm road or rail for each, preview them on the main map, then apply them all at once"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把目前清單裡的斷檔一次取路網草稿：先確認每處走公路還是鐵路，取完在主地圖預覽，再一次落地"
          }
        }
      }
    },
    "把当前视图（平面地图或地球）导出为 4K/8K PNG": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuelle Ansicht (flache Karte oder Globus) als 4K/8K-PNG exportieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export the current view (flat map or globe) as a 4K/8K PNG"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把目前的檢視（平面地圖或地球）匯出為 4K/8K PNG"
          }
        }
      }
    },
    "把按当前点距要插进去的合成点画出来（橙点），折线照旧；落地的就是这些点": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt die erzeugten Punkte, die beim aktuellen Abstand eingefügt werden (orange Punkte); die Linie bleibt. Genau diese Punkte werden übernommen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw the synthesized points that will be inserted at the current spacing (orange dots); the line stays. These are exactly the points that get applied"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把按目前點距要插進去的合成點畫出來（橙點），折線照舊；落地的就是這些點"
          }
        }
      }
    },
    "把整段回放导出为视频（离屏渲染，含底图与时间轴）": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesamte Wiedergabe als Video exportieren (Offscreen-Rendering, mit Basiskarte und Zeitleiste)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export the whole playback as a video (offscreen rendering, with basemap and timeline)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把整段回放匯出為影片（離屏渲染，含底圖與時間軸）"
          }
        }
      }
    },
    "把整段时光机回放离屏渲染为 H.264 视频（含底图、生长中的轨迹/迷雾与时间轴）。时长 = 当前回放时长，可先在时间轴调整。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesamte Zeitraffer-Wiedergabe offscreen als H.264-Video rendern (mit Basiskarte, wachsendem Track/Nebel und Zeitleiste). Dauer = aktuelle Wiedergabedauer; lässt sich vorher in der Zeitleiste anpassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Render the whole Timelapse playback offscreen to an H.264 video (with basemap, growing track/fog and timeline). Duration = current playback duration; adjust it on the timeline first if needed."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把整段時光機回放離屏渲染為 H.264 影片（含底圖、生長中的軌跡/迷霧與時間軸）。時長 = 目前回放時長，可先在時間軸調整。"
          }
        }
      }
    },
    "把这 %lld 处修改全部撤回：删掉补进去的 %lld 个点，加回删掉的 %lld 个点。还原本身不能再撤销。": {
      "comment": "Change Log › Revert All confirmation message. Placeholders in order: number of changes; number of filled-in points that will be deleted; number of deleted points that will be added back",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Änderungen (%1$lld) zurücknehmen: eingefügte Punkte (%2$lld) werden gelöscht, gelöschte Punkte (%3$lld) wiederhergestellt. Das Zurücksetzen selbst kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revert all changes (%1$lld): remove the filled-in points (%2$lld) and restore the deleted points (%3$lld). The revert itself cannot be undone."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把這 %lld 處修改全部撤回：刪掉補進去的 %lld 個點，加回刪掉的 %lld 個點。還原本身不能再撤銷。"
          }
        }
      }
    },
    "把这次删掉的 %lld 个点加回轨迹": {
