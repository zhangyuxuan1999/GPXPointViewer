+                let (r, cached) = await Self.cachedRoute(cache, key: key, ignoreCache: ignoreCache) {
+                    try await RoadNetwork.carRoute(a: A, b: B, bearingA: inp.a.heading.bearing, bearingB: inp.b.heading.bearing,
