+                                                roadOnly: roadOnly, cache: cache, routeCache: rcache, ignoreCache: true, coord: coord)
+            await MainActor.run {
+                self.batchRefetchTasks[id] = nil
+                guard self.batchGeneration == gen, var st = self.batch, st.items.indices.contains(i), st.items[i].id == item.id else { return }
+                if let out, !Task.isCancelled {
+                    self.applyBatchOutcome(out, index: i, item: item, gen: gen, crossCheck: crossCheck, engines: engines, downNow: [])
