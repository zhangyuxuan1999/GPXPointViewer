+            let cellPxHalf = camera.pxW / camera.w / Double(FogArchive.grid) / 2
+            var level = 0
+            if cellPxHalf < 0.75 { level = Int(ceil(log2(0.75 / cellPxHalf))) }
+            level = max(0, min(level, archive.levelKeys.count - 1))
