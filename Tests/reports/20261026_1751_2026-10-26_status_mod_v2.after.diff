+            await MainActor.run { [weak self] in
+                guard let self else { return }
+                self.tripMapRunning = false
+                self.tripMapProgress = nil
+                self.tripMapPhase = ""
+                self.tripMapStarted = nil
+                self.tripMapTask = nil
